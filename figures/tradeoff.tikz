\addplot[only marks, mark=diamond*, mark size=2.2pt, oivermillion, fill opacity=0.85] coordinates {(87.0,95.0)};
\addplot[only marks, mark=*, mark size=2.2pt, oigreen, fill opacity=0.85] coordinates {(41.7,95.0)};
